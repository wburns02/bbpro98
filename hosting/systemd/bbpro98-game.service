[Unit]
Description=BBPRO98 hosted: the game under Wine on :52
Requires=bbpro98-xvfb.service
After=bbpro98-xvfb.service
[Service]
# run-game.sh starts the game in a bubblewrap sandbox with its own environment (display, prefix, no system D-Bus,
# so Wine's mount manager maps no USB disks) and stops it from inside the same sandbox; `wineserver -k` exits 1
# when the server goes away mid-call, hence the "-".
ExecStartPre=/bin/sleep 3
ExecStart=/mnt/data/bbpro98/bin/run-game.sh
ExecStop=-/mnt/data/bbpro98/bin/run-game.sh stop
TimeoutStopSec=15
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
