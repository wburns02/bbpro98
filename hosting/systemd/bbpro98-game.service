[Unit]
Description=BBPRO98 hosted: the game under Wine on :52
Requires=bbpro98-xvfb.service
After=bbpro98-xvfb.service
[Service]
UnsetEnvironment=WAYLAND_DISPLAY XDG_SESSION_TYPE XAUTHORITY
# No system D-Bus: Wine's mount manager would map every mounted USB disk to a drive letter (run-game.sh drops
# the rest).
Environment=WINEPREFIX=/mnt/data/bbpro98/prefix WINEDEBUG=-all DISPLAY=:52 DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent
ExecStartPre=/bin/sleep 3
ExecStart=/mnt/data/bbpro98/bin/run-game.sh
ExecStop=/usr/bin/wineserver -k
TimeoutStopSec=15
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
