[Unit]
Description=BBPRO98 hosted: nginx on 127.0.0.1:6150, the tunnel's only target; every path needs the PIN cookie
After=bbpro98-gate.service
[Service]
ExecStartPre=/usr/bin/mkdir -p /mnt/data/bbpro98/gate/tmp
ExecStart=/usr/sbin/nginx -e stderr -p /mnt/data/bbpro98/gate/ -c /mnt/data/bbpro98/gate/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -e stderr -p /mnt/data/bbpro98/gate/ -c /mnt/data/bbpro98/gate/nginx.conf -s reload
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
