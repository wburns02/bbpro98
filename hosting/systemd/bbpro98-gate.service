[Unit]
Description=BBPRO98 hosted: PIN gate on 127.0.0.1:6154 (asked by bbpro98-proxy)
[Service]
ExecStart=/usr/bin/python3 /mnt/data/bbpro98/gate/gate.py --pin-file %h/.config/bbpro98/gate_pin --secret-file %h/.config/bbpro98/gate_secret
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
