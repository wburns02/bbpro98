# ~/.cloudflared/bbpro98.yml on the host. Create the tunnel with `cloudflared tunnel create bbpro98`.
# Every path goes to the PIN gate's nginx (hosting/nginx.conf), which routes /news and the game itself.
# Start the gate and the proxy BEFORE creating the hostname's DNS record.
tunnel: <tunnel-id>
credentials-file: /home/<user>/.cloudflared/<tunnel-id>.json
ingress:
  - hostname: <hostname>
    service: http://localhost:6150
  - service: http_status:404
